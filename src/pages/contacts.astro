---
import Base from '../layouts/Base.astro';
import { img } from '../data/site.js';
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
const pic = (id, alt) => { const m = img(id); return { src: `/img/t/${id}.jpg`, full: `/img/${id}.jpg`, w: m.w, h: m.h, alt }; };
// the three columns of the old page, top to bottom
const cols = [
  [ { id: 4997, html: '<b>"Diversity"</b> - social project, exhibited in 2017, Riga', link: '/portfolio/diversity/' },
    { yt: 'sgvylmg1LfQ', title: 'Diversity exhibition - setting up and opening' },
    { id: 4999, html: 'We are cooperating with many local fashion designers to film fashion landscape projects in our journeys across the Europe in attempt to express our vision of nature through the prism of fashion looks, combining landscape and fashion photography.<br>As a continuation we\'ve created traveling exhibition <b>"Iceland. Fashion and Landscape"</b>, that had been exhibited in Riga 2017, Ape 2018 and Sigulda 2019.', link: '/portfolio/iceland-landscape-and-fashion/' },
    { id: 5005, html: 'We have participated in International Art Fare <b>"Wings of Riga 2019"</b> with works from Gaze of Mountain and Iceland. Landscape and Fashion Series' } ],
  [ { id: 4998, html: 'Street photography project about the city night looks <b>"City. Other."</b> Riga 2017', link: '/portfolio/city-other/' },
    { id: 4996, html: '<b>"Gaze of mountain"</b> - exhibition of smArts.studio mountain photographs will be featuring paintings and dresses by artist Baiba Redere, Riga 2019', link: '/portfolio/gaze-of-mountain/' } ],
  [ { id: 4995, html: 'Our collaboration with Slokas animal shelter resulted in charity exhibition <b>"Happiness has a tail"</b>, Riga 2018', link: '/portfolio/slokas-animal-shelter/' },
    { id: 5004, html: 'In 2017 we also organized and facilitated young talents exhibition <b>"Fresh Talent Discovery"</b>. Gathering applications from hundreds of photographers from Latvia.' },
    { awards: true } ],
];
const love = [4977,4976,4978,4979,4982,4985,4981,4980,4983,4984];
const s = pic(4974, 'Sergey'), m = pic(4975, 'Maria');
---
<Base title="About Us" description="We are smArts.studio - Maria and Sergey. Photo and video self-expression, open for collaboration projects.">
  <div class="about">
    <div>
      <p>We are smArts.studio - Maria and Sergey. We are working with photo and video self-expression and open for collaboration projects. If you are interested in our work, want to buy our art or to offer collab, please get in touch!</p>
      <h3>Let's connect, say <span data-typed="Hi;Salut;您好;Merhaba;Ciao;Ahoj;Tung;Hello">Hi</span> to us.</h3>
      <div class="soc"><a href="https://pranka.id.lv/" title="Pranka Colour" aria-label="Pranka Colour">PC</a><a href="https://pranka.id.lv/vue/" title="Pranka VUE" aria-label="Pranka VUE">PV</a><a href="mailto:iampranka@gmail.com?subject=Hello!" title="Email" aria-label="Email">@</a></div>
      <div class="team">
        <figure><img src={s.src} width={s.w} height={s.h} alt="Sergey"><figcaption>Guru of all the buttons and wires. The person who delivers all we have in mind to your eyes.</figcaption></figure>
        <figure><img src={m.src} width={m.w} height={m.h} alt="Maria"><figcaption>Creativity goddess, who starts all the ideas and projects. Engine that drives us through art.</figcaption></figure>
      </div>
    </div>
    <div>
      {key ? (
      <form id="cf" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={key}>
        <input type="hidden" name="subject" value="New message from smarts.studio">
        <input type="hidden" name="from_name" value="smarts.studio">
        <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off">
        <p style="font-size:13px;color:var(--mute)">Fields marked with an <b style="color:var(--red)">*</b> are required</p>
        <label>Name<input name="name" autocomplete="name"></label>
        <label>Email <b>*</b><input name="email" type="email" required autocomplete="email"></label>
        <label>Message <b>*</b><textarea name="message" rows="8" required></textarea></label>
        <button class="btn" type="submit">Submit</button>
        <p id="cfmsg" role="status" style="margin-top:14px"></p>
      </form>
      ) : (
      <p><a class="btn" href="mailto:iampranka@gmail.com">Write to us: iampranka@gmail.com</a></p>
      )}
    </div>
  </div>
  <div class="sep">from 2017 we had several individual exhibitions in Latvia</div>
  <div class="cols3">
    {cols.map(col => <div>{col.map(c => {
      if (c.yt) return <div><button class="yt" data-id={c.yt} aria-label={`Play: ${c.title}`}><img src={`https://i.ytimg.com/vi/${c.yt}/maxresdefault.jpg`} alt="" loading="lazy" style="margin:0"></button></div>;
      if (c.awards) return <div><hr><p>Between us we have couple of <b>photography awards</b></p><blockquote>second and third place in<br>Sony World Photography awards (National),<br>Latvia best photos (Top 50)<br>35 AWARDS 2016 Top 10 Latvia<br>35 AWARDS 2016 Top 20 Staged Photo.</blockquote></div>;
      const p = pic(c.id, 'Exhibition photo');
      return <div><a href={p.full} data-lb><img src={p.src} width={p.w} height={p.h} alt={p.alt} loading="lazy"></a><p set:html={c.html} />{c.link && <a href={c.link}>See in portfolio</a>}</div>; })}</div>)}
  </div>
  <div class="sep">please explore our art, be inspired by it and enjoy</div>
  <div class="love">
    <h4>smArts.studio, with love</h4>
    <div class="tiles">
      {love.map(id => { const p = pic(id, 'smArts.studio, with love'); return <a href={p.full} data-lb><img src={p.src} width={p.w} height={p.h} alt={p.alt} loading="lazy"></a>; })}
    </div>
  </div>
  <script is:inline src="/lightbox.js?v=6" defer></script>
  <script is:inline src="/gallery.js?v=6" defer></script>
  <script is:inline src="/typed.js?v=6" defer></script>
  <script is:inline>
  (()=>{const f=document.getElementById('cf');if(!f)return;const m=document.getElementById('cfmsg');
  f.addEventListener('submit',async e=>{e.preventDefault();m.textContent='Sending...';
    try{const r=await fetch(f.action,{method:'POST',body:new FormData(f),headers:{Accept:'application/json'}});const j=await r.json();
      if(j.success){f.reset();m.textContent='Thank you! We will get back to you soon.'}else throw 0}
    catch{m.textContent='Could not send. Please write to iampranka@gmail.com.'}});})();
  </script>
</Base>
